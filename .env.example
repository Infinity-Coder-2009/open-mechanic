# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmechanic?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NVIDIA NIM API
NVIDIA_API_KEY="your_nvidia_api_key_here"
